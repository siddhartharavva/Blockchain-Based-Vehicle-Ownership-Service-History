# Copy to .env. Everything is optional for a local Hardhat demo.

# Pinata JWT for real IPFS uploads. Leave empty to store documents in this browser instead
# (content-addressed the same way, so CIDs and hash checks still work).
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Chain the app reads from. Defaults: 31337 + http://127.0.0.1:8545 (Hardhat).
# For a phone on your Wi-Fi use your computer's LAN IP, e.g. http://192.168.1.20:8545
# (start the node with `npx hardhat node --hostname 0.0.0.0`).
# For Sepolia: VITE_CHAIN_ID=11155111 and a public RPC URL.
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
