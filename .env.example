# Only needed for deploying to the Sepolia testnet. Local Hardhat needs none of these.
# Copy to .env and fill in. Never commit .env.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
PRIVATE_KEY=<test-wallet-private-key-never-a-real-one>
ETHERSCAN_API_KEY=<optional-etherscan-key>
# Optional: write a gas report to gas-report.txt when REPORT_GAS=true
REPORT_GAS=false
